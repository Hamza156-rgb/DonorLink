rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signed() { return request.auth != null; }
    function me(uid) { return signed() && request.auth.uid == uid; }
    function admin() { return signed() && request.auth.token.admin == true; }
    function keep(f) { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(f); }
    // Guest = anonymous session (donor search only). account() = real email account, verified() = confirmed email.
    function guest() { return signed() && request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'anonymous'; }
    function account() { return signed() && !guest(); }
    function mine(uid) { return me(uid) && account(); }
    function verified() { return account() && request.auth.token.email_verified == true; }
    function privateProfileOk(d) {
      return d.keys().hasOnly(['fullName','phone','email','preferredContact','createdAt','updatedAt'])
        && d.keys().hasAll(['fullName','email','preferredContact','createdAt','updatedAt'])
        && d.fullName is string && d.fullName.size() >= 2 && d.fullName.size() <= 80
        && d.email == request.auth.token.email
        && d.preferredContact in ['in_app','phone','whatsapp']
        && (!('phone' in d) || (d.phone is string && d.phone.matches('^[+]923[0-9]{9}$')))
        && d.updatedAt == request.time;
    }

    function donorListingOk(d) {
      return d.keys().hasOnly(['displayName','bloodGroup','province','city','availability','discoverable','verified','updatedAt','pausedUntil'])
        && d.keys().hasAll(['displayName','bloodGroup','province','city','availability','discoverable','verified','updatedAt'])
        && d.displayName is string && d.displayName.size() >= 2 && d.displayName.size() <= 40
        && d.bloodGroup in ['A+','A-','B+','B-','AB+','AB-','O+','O-']
        && d.city is string && d.city.size() >= 2 && d.city.size() <= 60
        && d.province in ['Punjab','Sindh','Khyber Pakhtunkhwa','Balochistan','Islamabad Capital Territory','Gilgit-Baltistan','Azad Kashmir']
        && d.availability in ['available','temporarily_unavailable','not_donating']
        && d.discoverable is bool
        // Optional "back in search on" date (set after a donation, or any pause). Says nothing about why; max one year ahead.
        && (!('pausedUntil' in d) || (d.pausedUntil is timestamp && d.pausedUntil <= request.time + duration.value(366, 'd')))
        && d.updatedAt == request.time;
    }

    // Private account data: owner only. role/suspended live in custom claims + server fields.
    match /privateProfiles/{uid} {
      allow read: if me(uid);
      allow create: if mine(uid) && privateProfileOk(request.resource.data) && request.resource.data.createdAt == request.time;
      allow update: if mine(uid) && privateProfileOk(request.resource.data) && keep(['createdAt']);
      allow delete: if false;
    }
    // Consented, coarse discovery data only. No phone/email/address here.
    match /publicDonorProfiles/{uid} {
      // Anyone with a session (guests included) can search, max 15 per page so the list can't be bulk-copied.
      allow get: if signed();
      allow list: if signed() && request.query.limit <= 15;
      // Only verified accounts can list themselves as donors.
      allow create, update: if mine(uid) && verified() && donorListingOk(request.resource.data)
        && request.resource.data.verified == (resource == null ? false : resource.data.verified);
      allow delete: if me(uid);
    }
    match /bloodRequests/{id} {
      allow read: if signed() && (resource.data.status in ['open','in_progress'] || resource.data.requesterId == request.auth.uid || admin());
      allow create: if verified() && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.status == 'pending_review' && request.resource.data.confirmedAccurate == true;
      allow update: if verified() && resource.data.requesterId == request.auth.uid
        && keep(['requesterId','status','createdAt']) ;
      allow delete: if false;   // status changes go through Cloud Functions
    }
    // ---------- Contact workflow (runs on the free plan: every check lives here, no Cloud Functions)
    function quota() { return /databases/$(db)/documents/requestQuota/$(request.auth.uid); }
    // A new (or re-sent after decline) request from a verified account to a listed donor.
    function newRequestOk(id) {
      let d = request.resource.data;
      let donor = get(/databases/$(db)/documents/publicDonorProfiles/$(d.toUid)).data;
      let me = get(/databases/$(db)/documents/privateProfiles/$(request.auth.uid)).data;
      return verified()
        && id == request.auth.uid + '_' + d.toUid
        && d.fromUid == request.auth.uid && d.toUid != request.auth.uid
        && d.keys().hasOnly(['fromUid','toUid','status','fromName','toName','bloodGroup','urgency','hospital','city','message','createdAt','updatedAt'])
        && d.keys().hasAll(['fromUid','toUid','status','fromName','toName','bloodGroup','urgency','hospital','city','message','createdAt','updatedAt'])
        && d.status == 'pending'
        && d.bloodGroup in ['A+','A-','B+','B-','AB+','AB-','O+','O-']
        && d.urgency in ['today','this_week','planned']
        && d.hospital is string && d.hospital.size() >= 2 && d.hospital.size() <= 120
        && d.message is string && d.message.size() <= 300
        && d.createdAt == request.time && d.updatedAt == request.time
        && donor.discoverable == true && d.toName == donor.displayName && d.city == donor.city   // real, listed donor
        && (!('pausedUntil' in donor) || donor.pausedUntil <= request.time)                     // not resting/paused
        && d.fromName == me.fullName                                                            // requester's real name
        && !exists(/databases/$(db)/documents/blockedUsers/$(d.toUid)/blocked/$(request.auth.uid))
        && getAfter(quota()).data.lastRequestId == id && getAfter(quota()).data.lastRequestAt == request.time;  // counted below
    }
    // Donor answers. Accepting must share exactly the donor's own name/phone/preference from their private profile.
    function answerOk() {
      let d = request.resource.data;
      let p = get(/databases/$(db)/documents/privateProfiles/$(request.auth.uid)).data;
      return verified() && resource.data.toUid == request.auth.uid && resource.data.status == 'pending'
        && d.diff(resource.data).affectedKeys().hasOnly(['status','respondedAt','updatedAt','sharedContact'])
        && d.respondedAt == request.time && d.updatedAt == request.time
        && ((d.status == 'declined' && !('sharedContact' in d))
          || (d.status == 'accepted' && d.sharedContact == { 'name': p.fullName, 'phone': p.phone, 'preferredContact': p.preferredContact }));
    }
    match /contactRequests/{id} {
      // Only the two people involved. (A missing doc reveals nothing, so the app can check for an open request first.)
      allow read: if signed() && (resource == null || resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if newRequestOk(id);
      allow update: if (resource.data.fromUid == request.auth.uid && resource.data.status == 'declined' && newRequestOk(id))
        || answerOk();
      allow delete: if false;
    }
    // Rate limit: max 5 requests per rolling hour window, bumped in the same batch as each request.
    match /requestQuota/{uid} {
      allow read: if mine(uid);
      allow create, update: if mine(uid) && verified()
        && request.resource.data.keys().hasOnly(['windowStart','count','lastRequestId','lastRequestAt'])
        && request.resource.data.lastRequestAt == request.time
        && getAfter(/databases/$(db)/documents/contactRequests/$(request.resource.data.lastRequestId)).data.fromUid == uid
        && getAfter(/databases/$(db)/documents/contactRequests/$(request.resource.data.lastRequestId)).data.updatedAt == request.time
        && ((request.resource.data.windowStart == request.time && request.resource.data.count == 1
              && (resource == null || resource.data.windowStart < request.time - duration.value(1, 'h')))
          || (resource != null && resource.data.windowStart >= request.time - duration.value(1, 'h')
              && request.resource.data.windowStart == resource.data.windowStart
              && request.resource.data.count == resource.data.count + 1 && request.resource.data.count <= 5));
      allow delete: if false;
    }
    // ---------- Donation history: owner only. Never public; the listing only carries a neutral pausedUntil date.
    function donationOk(uid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['donatedOn','place','requestId','createdAt'])
        && d.keys().hasAll(['donatedOn','place','createdAt'])
        && d.donatedOn is timestamp && d.donatedOn <= request.time + duration.value(1, 'd')       // not in the future
        && d.donatedOn >= request.time - duration.value(3650, 'd')
        && d.place is string && d.place.size() <= 120
        // Linked request must be one this donor accepted.
        && (!('requestId' in d) || (d.requestId is string
          && get(/databases/$(db)/documents/contactRequests/$(d.requestId)).data.toUid == uid
          && get(/databases/$(db)/documents/contactRequests/$(d.requestId)).data.status == 'accepted'));
    }
    match /donationHistory/{uid}/entries/{e} {
      allow read, delete: if mine(uid);
      allow create: if mine(uid) && donationOk(uid) && request.resource.data.createdAt == request.time;
      allow update: if mine(uid) && donationOk(uid) && keep(['createdAt']);
    }
    match /blockedUsers/{uid}/blocked/{b}    { allow read, write: if mine(uid); }
    match /userNotifications/{uid}/items/{n} { allow read: if me(uid); allow update: if me(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']); }
    match /deviceTokens/{uid}/tokens/{t}     { allow read, write: if mine(uid); }
    match /userReports/{id} { allow create: if account() && request.resource.data.reporterId == request.auth.uid; allow read: if admin(); }
    match /appAnnouncements/{id} { allow read: if true; allow write: if admin(); }
    match /{coll}/{doc=**} { allow read, write: if coll in ['adminAuditLogs','platformSettings','verificationSubmissions'] && admin() && request.method == 'get' || false; }
  }
}
