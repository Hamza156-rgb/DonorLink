{
  "name": "donorlink",
  "version": "0.0.1",
  "author": "Ionic Framework",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "test:rules": "npm --prefix tests test",
    "emulators": "firebase emulators:start --project demo-donorlink",
    "test:rules:ci": "npm --prefix functions run build && firebase emulators:exec --only auth,firestore,functions --project demo-donorlink \"npm run test:rules\"",
    "seed": "node scripts/seed-emulator.mjs",
    "dev": "firebase emulators:exec --project demo-donorlink --ui \"node scripts/seed-emulator.mjs && ionic serve\""
  },
  "private": true,
  "dependencies": {
    "@angular/common": "~20.3.0",
    "@angular/compiler": "~20.3.0",
    "@angular/core": "~20.3.0",
    "@angular/fire": "20.1.1",
    "@angular/forms": "~20.3.0",
    "@angular/platform-browser": "~20.3.0",
    "@angular/router": "~20.3.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@ionic/angular": "^9.0.0",
    "firebase": "^11.10.0",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "~20.3.0",
    "@angular/cli": "~20.3.0",
    "@angular/compiler-cli": "~20.3.0",
    "@angular/language-service": "~20.3.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "8.5.3",
    "@ionic/angular-toolkit": "^12.3.0",
    "angular-eslint": "20.7.0",
    "eslint": "^9.39.0",
    "firebase-tools": "^15.34.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "^3.2.0"
  },
  "description": "An Ionic project",
  "engines": {
    "node": ">=20.19 <21 || >=22.12"
  }
}
