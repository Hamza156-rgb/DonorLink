rules_version = '2';
service firebase.storage {
  match /b/{b}/o {
    match /avatars/{uid}/{f} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == uid && request.resource.size < 1024*1024 && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    match /{p=**} { allow read, write: if false; }
  }
}
